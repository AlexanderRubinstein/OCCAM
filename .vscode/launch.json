            "request": "launch",
            "program": "./scripts/predict_masks.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--model_id",
                "dinosaur_base_patch14_518_topk3.coco_dv2_ft_s7_300k+10k",
